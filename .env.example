# Токен бота от @BotFather
BOT_TOKEN=

# ID чата менеджера, куда приходят лиды (узнать: отправьте боту /myid)
ADMIN_CHAT_ID=

# Входящий вебхук Битрикс24 с правами CRM, например:
# https://your-company.bitrix24.ru/rest/1/abc123def456/
# Пусто — лиды сохраняются только в боте и приходят менеджеру в Telegram
BITRIX_WEBHOOK=

# Через сколько минут молчания напомнить клиенту о себе (один раз)
NUDGE_MINUTES=120

TIMEZONE=Europe/Moscow

# ИИ: none | openai | anthropic | gigachat  (none — сценарий без ИИ)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_REASONING_EFFORT=

# Groq — бесплатно, без карты. Ключ: https://console.groq.com/keys
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_REASONING_EFFORT=low
